          <path d="M42 22 C35 15, 35 30, 42 26 Z" fill="#FFD1DC"/>
          <path d="M58 22 C65 15, 65 30, 58 26 Z" fill="#FFD1DC"/>
          <circle cx="50" cy="24" r="4" fill="#FF9B42"/>
        </svg>
        <p>點擊抽取今日幸運小語</p>
        <span>✨ 輕觸卡片翻面 ✨</span>
      </div>
      <div class="card-face card-back">
        <div class="quote-content" id="quoteText">點擊下方按鈕抽取第一張靈感卡片吧！</div>
        <div class="quote-author" id="quoteAuthor">—— 今日靈感</div>
      </div>
    </div>
  </div>

  <button class="action-btn" id="drawBtn">再抽一張 🎲</button>

  <!-- 📸 旅程精選照片 AI 拍立得拼圖區 -->
  <div class="photo-section">
    <h3>📸 每日精選 4 格拍立得拼圖</h3>
    <p>上傳今日精選的 4 張照片，自動生成三麗鷗紀念貼圖！</p>
    
    <label class="upload-btn" for="fileInput">📷 選擇 4 張照片</label>
    <input type="file" id="fileInput" accept="image/*" multiple onchange="generateCollage(event)">
    
    <canvas id="collageCanvas" width="800" height="980"></canvas>
    <button class="download-btn" id="downloadBtn" onclick="downloadCollage()">💾 保存拍立得拼圖</button>
  </div>

  <script>
    // 計算旅程天數（自 10/26 開始）
    function updateTripCounter() {
      const now = new Date();
      const currentYear = now.getFullYear();
      
      const startDate = new Date(currentYear, 9, 26); // 10 月 26 日
      const endDate = new Date(currentYear, 10, 12);   // 11 月 12 日
      
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const counterElem = document.getElementById('tripCounter');
      if (!counterElem) return;

      const diffTimeStart = startDate - today;
      const diffDaysStart = Math.ceil(diffTimeStart / (1000 * 60 * 60 * 24));

      if (diffDaysStart > 0) {
        counterElem.textContent = `距離 10/26 出發還有 ${diffDaysStart} 天 ✈️`;
      } else {
        const dayOfTrip = Math.floor((today - startDate) / (1000 * 60 * 60 * 24)) + 1;
        if (today <= endDate) {
          counterElem.textContent = `日本旅程第 Day ${dayOfTrip} 天 🍁`;
        } else {
          counterElem.textContent = `旅程圓滿結束 🌸`;
        }
      }
    }

    // 📸 自動生成 4 格三麗鷗風拍立得
    function generateCollage(event) {
      const files = event.target.files;
      if (files.length < 4) {
        alert("請選擇剛好 4 張照片喔！");
        return;
      }

      const canvas = document.getElementById('collageCanvas');
      const ctx = canvas.getContext('2d');
      const downloadBtn = document.getElementById('downloadBtn');

      // 背景塗成奶油黃
      ctx.fillStyle = '#FFFDF2';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // 邊框背景加卡片圓角底色
      ctx.fillStyle = '#FFF2B2';
      ctx.roundRect(20, 20, 760, 940, 30);
      ctx.fill();

      let loadedImages = [];
      for (let i = 0; i < 4; i++) {
        const img = new Image();
        img.src = URL.createObjectURL(files[i]);
        img.onload = () => {
          loadedImages.push(img);
          if (loadedImages.length === 4) {
            drawImagesGrid(ctx, loadedImages, canvas);
            canvas.style.display = 'block';
            downloadBtn.style.display = 'block';
          }
        };
      }
    }

    function drawImagesGrid(ctx, images, canvas) {
      const positions = [
        { x: 50, y: 50 },   // 左上
        { x: 410, y: 50 },  // 右上
        { x: 50, y: 410 },  // 左下
        { x: 410, y: 410 }  // 右下
      ];

      positions.forEach((pos, idx) => {
        const img = images[idx];
        
        // 白框
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(pos.x - 10, pos.y - 10, 360, 360);

        // 正方形裁切
        const minSide = Math.min(img.width, img.height);
        const sx = (img.width - minSide) / 2;
        const sy = (img.height - minSide) / 2;

        ctx.drawImage(img, sx, sy, minSide, minSide, pos.x, pos.y, 340, 340);
      });

      // 拍立得底部日系可愛簽名
      ctx.fillStyle = '#FF9B42';
      ctx.font = 'bold 32px "Zen Maru Gothic", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('✨ Japan Trip - Daily Special Memories ✨', canvas.width / 2, 830);
      
      ctx.fillStyle = '#9E8E85';
      ctx.font = '500 22px "Zen Maru Gothic", sans-serif';
      ctx.fillText('—— 記下在日本遇見的溫柔景色 🎀', canvas.width / 2, 875);
    }

    function downloadCollage() {
      const canvas = document.getElementById('collageCanvas');
      const link = document.createElement('a');
      link.download = 'Japan_Trip_Collage.png';
      link.href = canvas.toDataURL();
      link.click();
    }

