    let isFlipping = false;
    const cardContainer = document.getElementById('cardContainer');
    const drawBtn = document.getElementById('drawBtn');

    function handleDraw() {
      const card = document.getElementById('quoteCard');
      if (!card || isFlipping) return;

      if (card.classList.contains('flipped')) {
        isFlipping = true;
        card.classList.remove('flipped');
        setTimeout(() => {
          showRandomQuote();
          isFlipping = false;
        }, 350);
      } else {
        showRandomQuote();
        card.classList.add('flipped');
      }
    }

    cardContainer.addEventListener('click', handleDraw);
    drawBtn.addEventListener('click', handleDraw);

    function showRandomQuote() {
      const quoteText = document.getElementById('quoteText');
      const quoteAuthor = document.getElementById('quoteAuthor');
      const randomIndex = Math.floor(Math.random() * quotes.length);
      const selected = quotes[randomIndex];
      
      if (quoteText && quoteAuthor) {
        quoteText.textContent = selected.text;
        quoteAuthor.textContent = selected.author;
      }
    }

    const cityCoords = {
      nagoya: { lat: 35.1815, lon: 136.9064, name: "名古屋" },
      fukuoka: { lat: 33.5902, lon: 130.4017, name: "福岡" }
    };

    function fetchWeather() {
      const citySelect = document.getElementById('citySelect');
      if (!citySelect) return;

      const cityKey = citySelect.value;
      const coords = cityCoords[cityKey];
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${coords.lat}&longitude=${coords.lon}&current_weather=true`;

      document.getElementById('tempDisplay').textContent = "讀取...";
      document.getElementById('outfitText').textContent = "連線查詢最新天氣與穿搭建議...";

      fetch(url)
        .then(res => res.json())
        .then(data => {
          const temp = Math.round(data.current_weather.temperature);
          const code = data.current_weather.weathercode;
          
          document.getElementById('tempDisplay').textContent = `${temp}°C`;
          
          let icon = "🌤️";
          if (code === 0) icon = "☀️";
          else if (code >= 1 && code <= 3) icon = "⛅";
          else if (code >= 51) icon = "🌧️";

          document.getElementById('weatherIcon').textContent = icon;

          let outfit = "";
          if (temp < 15) {
            outfit = "天氣偏涼，建議穿厚外套或刷毛上衣，圍巾備著更保暖！";
          } else if (temp >= 15 && temp <= 22) {
            outfit = "舒爽涼意，推薦「薄長袖 + 風衣/針織外套」洋蔥式穿搭。";
          } else {
            outfit = "氣溫舒適，穿薄長袖或短袖搭件輕便襯衫即可輕鬆出門！";
          }

          if (code >= 51) outfit += "（今天有雨，出門記得帶傘喔！）";

          document.getElementById('outfitText').textContent = outfit;
        })
        .catch(err => {
          document.getElementById('tempDisplay').textContent = "16°C";
          document.getElementById('weatherIcon').textContent = "🍁";
          document.getElementById('outfitText').textContent = "秋季早晚溫差大，建議「薄長袖 + 防風外套」洋蔥式搭法！";
        });
    }

    window.onload = function() {
      updateTripCounter();
      fetchWeather();
    };
  </script>
